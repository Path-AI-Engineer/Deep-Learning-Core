    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "jsdom": "27.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.0.18"
  }
}
